# Docker web-plane + host-native NVIDIA runtime example.
# Copy to `.env.web-plane.host-kit` only if local overrides are needed.
# Do not add secrets here; this file is safe to commit.

COMPOSE_PROJECT_NAME=ai-bim-web-plane-host-kit

# Published web-plane ports on the host.
COORDINATOR_PORT=8004
VIEWER_PORT=5173
# Host-native Kit runtime authority calls must stay on loopback. Leave the base
# empty to derive http://127.0.0.1:<COORDINATOR_PORT> in scripts/deploy.ps1.
COORDINATOR_INTERNAL_API_BASE=
# Private value shared with bim-review-coordinator. Never commit a real token.
INTERNAL_API_AUTH_TOKEN=
# Private A4 coordinator/governance context token (minimum 16 characters).
# Both processes receive it from the real env file; never commit a real value.
A4_INTERNAL_CONTEXT_TOKEN=
# LAN demo default publishes viewer/coordinator/Kit WebRTC on the host IP.
# For local-only demo override PUBLIC_HOST=127.0.0.1 and VIEWER_BIND_HOST=127.0.0.1.
PUBLIC_HOST=192.168.10.105
VIEWER_BIND_HOST=0.0.0.0

# Host bridge profile:
# - windows-docker-desktop: Docker Desktop usually resolves host.docker.internal
# - linux-host-gateway: compose.host-kit.yml adds host.docker.internal:host-gateway
# - explicit-host-address: set HOST_CONVERSION_API_BASE to a LAN/DNS address
HOST_BRIDGE_PROFILE=windows-docker-desktop

# URL visible from the coordinator container to the host-native conversion API.
HOST_CONVERSION_API_BASE=http://host.docker.internal:49101

# URL visible from the user's browser to the coordinator.
# Leave WEB_VIEWER_COORDINATOR_API_BASE unset to derive it from PUBLIC_HOST and COORDINATOR_PORT.
# WEB_VIEWER_COORDINATOR_API_BASE=http://192.168.10.105:8004
# Leave WEB_VIEWER_COORDINATOR_SOCKET_URL unset to derive it from PUBLIC_HOST and COORDINATOR_PORT.
# WEB_VIEWER_COORDINATOR_SOCKET_URL=http://192.168.10.105:8004
# Leave VIEWER_PUBLIC_BASE_URL / COORDINATOR_PUBLIC_BASE_URL unset to derive from PUBLIC_HOST.
# VIEWER_PUBLIC_BASE_URL=http://192.168.10.105:5173
# COORDINATOR_PUBLIC_BASE_URL=http://192.168.10.105:8004

# Browser-visible Kit/WebRTC endpoint. This is not a container hostname.
# Leave KIT_SIGNALING_HOST / KIT_MEDIA_HOST unset to derive from PUBLIC_HOST.
# KIT_SIGNALING_HOST=192.168.10.105
KIT_SIGNALING_PORT=49100
# KIT_MEDIA_HOST=192.168.10.105
KIT_MEDIA_PORT=47998
KIT_CONTROL_URL=

# Same-Kit spectator streams. Default gives 5 spectator viewer slots in addition
# to the primary stream. Set KIT_SPECTATOR_COUNT=4 if the desired total is 5 viewers.
KIT_SPECTATOR_COUNT=5
KIT_SPECTATOR_SIGNALING_PORT_START=49110
KIT_SPECTATOR_MEDIA_PORT_START=48008
KIT_SPECTATOR_PORT_STRIDE=10

# Host-native conversion output ownership.
# These are consumed by bim-streaming-server/scripts/start-host-native-conversion-service.ps1.
STREAMING_CONVERSION_ARTIFACTS_ROOT=./bim-streaming-server/_cache/host-native-conversion/artifacts
STREAMING_CONVERSION_JOBS_DIR=./bim-streaming-server/_cache/host-native-conversion/jobs
# Browser/Kit-visible conversion artifacts URL.
STREAMING_CONVERSION_PUBLIC_ARTIFACTS_URL=http://192.168.10.105:49101/artifacts

# Runtime mode label for scripts/evidence only; this does not enable Docker GPU Kit.
RUNTIME_MODE=hybrid-web-plane-host-native-kit

# URL visible from the coordinator container to the host-native governance API.
HOST_GOVERNANCE_API_BASE=http://host.docker.internal:49102
# Host path for runtime storage volume binding. Relative paths resolve from repo root.
RUNTIME_STORAGE_ROOT=./storage

# Test deployment MinIO auto-detect defaults.
# This profile intentionally opts in to the watcher for the deployment test area,
# but credentials must remain in the private .env.web-plane.host-kit file.
MINIO_WATCH_ENABLED=true
MINIO_WATCH_ENDPOINT=http://192.168.20.234:9000
MINIO_WATCH_BUCKET=bim-control
MINIO_WATCH_PREFIX=
MINIO_WATCH_ACCESS_KEY=
MINIO_WATCH_SECRET_KEY=
MINIO_WATCH_INTERVAL_SECONDS=60
MINIO_WATCH_INTERVAL_FLOOR_SECONDS=
MINIO_WATCH_KEY_SUFFIX=/model.ifc
MINIO_WATCH_TENANT_ID=
MINIO_WATCH_SELF_BASE_URL=

# unified-console-runtime-truth（owner D3 裁決 2026-08-25）：coordinator /api/dev/* demo 路由開關，經 compose.host-kit.yml 透傳。
# 空＝維持開啟（local-windows／隔離 branch stack）；canonical-linux 的私有 .env.web-plane.host-kit 設 false → /api/dev/* 整組 404。
ENABLE_DEV_ROUTES=
# unified-console-runtime-truth（owner D2=T4 裁決）：conversion 控制路由的 operator token（沿用 Kit mutation dev token，header x-operator-token）。
# 空＝容器取 compose 預設 dev-token → token 路徑視為未啟用（fail-closed，只剩 IP allowlist）；canonical-linux 必須設非預設值，真值只放私有 env。
DEV_AUTH_TOKEN=
