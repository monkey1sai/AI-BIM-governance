# Docker web-plane + host-native NVIDIA runtime example.
# Copy to `.env.web-plane.host-kit` only if local overrides are needed.
# Do not add secrets here; this file is safe to commit.

COMPOSE_PROJECT_NAME=ai-bim-web-plane-host-kit

# Published web-plane ports on the host.
COORDINATOR_PORT=8004
VIEWER_PORT=5173
# Local-only default keeps viewer bound to loopback. For LAN demo set:
# PUBLIC_HOST=<server-lan-ip>
# VIEWER_BIND_HOST=0.0.0.0
PUBLIC_HOST=127.0.0.1
VIEWER_BIND_HOST=127.0.0.1

# Host bridge profile:
# - windows-docker-desktop: Docker Desktop usually resolves host.docker.internal
# - linux-host-gateway: compose.host-kit.yml adds host.docker.internal:host-gateway
# - explicit-host-address: set HOST_CONVERSION_API_BASE to a LAN/DNS address
HOST_BRIDGE_PROFILE=windows-docker-desktop

# URL visible from the coordinator container to the host-native conversion API.
HOST_CONVERSION_API_BASE=http://host.docker.internal:49101

# URL visible from the user's browser to the coordinator.
# Leave WEB_VIEWER_COORDINATOR_API_BASE unset to derive it from PUBLIC_HOST and COORDINATOR_PORT.
# WEB_VIEWER_COORDINATOR_API_BASE=http://127.0.0.1:8004
# Leave WEB_VIEWER_COORDINATOR_SOCKET_URL unset to derive it from PUBLIC_HOST and COORDINATOR_PORT.
# WEB_VIEWER_COORDINATOR_SOCKET_URL=http://127.0.0.1:8004
# Leave VIEWER_PUBLIC_BASE_URL / COORDINATOR_PUBLIC_BASE_URL unset to derive from PUBLIC_HOST.
# VIEWER_PUBLIC_BASE_URL=http://127.0.0.1:5173
# COORDINATOR_PUBLIC_BASE_URL=http://127.0.0.1:8004

# Browser-visible Kit/WebRTC endpoint. This is not a container hostname.
# Leave KIT_SIGNALING_HOST / KIT_MEDIA_HOST unset to derive from PUBLIC_HOST.
# KIT_SIGNALING_HOST=127.0.0.1
KIT_SIGNALING_PORT=49100
# KIT_MEDIA_HOST=127.0.0.1
KIT_MEDIA_PORT=47998

# Same-Kit spectator streams. Default gives 5 spectator viewer slots in addition
# to the primary stream. Set KIT_SPECTATOR_COUNT=4 if the desired total is 5 viewers.
KIT_SPECTATOR_COUNT=5
KIT_SPECTATOR_SIGNALING_PORT_START=49110
KIT_SPECTATOR_MEDIA_PORT_START=48008
KIT_SPECTATOR_PORT_STRIDE=10

# Host-native conversion output ownership.
# These are consumed by bim-streaming-server/scripts/start-host-native-conversion-service.ps1.
STREAMING_CONVERSION_ARTIFACTS_ROOT=./bim-streaming-server/_cache/host-native-conversion/artifacts
STREAMING_CONVERSION_JOBS_DIR=./bim-streaming-server/_cache/host-native-conversion/jobs
# For LAN demo, set this to http://<server-lan-ip>:49101/artifacts when the
# consuming Kit/runtime perspective needs a non-loopback artifact URL.
STREAMING_CONVERSION_PUBLIC_ARTIFACTS_URL=http://127.0.0.1:49101/artifacts

# Runtime mode label for scripts/evidence only; this does not enable Docker GPU Kit.
RUNTIME_MODE=hybrid-web-plane-host-native-kit
