{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim-docs.jackshappybot.com/contracts/cfd-estimate-request-v1.schema.json",
  "title": "cfd-estimate-request/v1",
  "description": "S8: body of POST /api/cfd-estimates (streaming) and POST /api/cfd/estimates (coordinator). A cfd-run-request/v1 without idempotency_key, source.model_usdc_sha256 and requested_by; preprocess, wind, mesh and solver are the run-request definitions verbatim (tests/test_cfd_contracts.py pins the equality), and the streaming service validates them with the same function as a submission. Nothing is stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "preprocess",
    "wind"
  ],
  "properties": {
    "schema": {
      "const": "cfd-estimate-request/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversion_job_id"
      ],
      "properties": {
        "conversion_job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,200}$"
        }
      }
    },
    "preprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "enum": [
            "exterior-wind/v1"
          ]
        },
        "voxel_pitch_m": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0,
          "default": 0.5
        },
        "closing_radius_voxels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 4
        },
        "leak_fraction_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.15,
          "description": "Runs whose measured leak_fraction exceeds this are still produced but flagged sealing_suspect; owner accepted 0.12 on the reference building, hence the 0.15 default."
        }
      }
    },
    "wind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wind_from_degrees",
        "uref_m_s",
        "zref_m",
        "z0_m",
        "true_north_source"
      ],
      "properties": {
        "wind_from_degrees": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "description": "Meteorological: direction the wind blows FROM, degrees clockwise from true north."
        },
        "uref_m_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 40
        },
        "zref_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "z0_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "true_north_source": {
          "enum": [
            "geo_reference",
            "manual"
          ]
        },
        "true_north_degrees_manual": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        }
      },
      "if": {
        "properties": {
          "true_north_source": {
            "const": "manual"
          }
        }
      },
      "then": {
        "required": [
          "true_north_degrees_manual"
        ],
        "properties": {
          "true_north_degrees_manual": {
            "type": "number"
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background_cell_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.5,
          "maximum": 20
        },
        "surface_refinement_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "default": 2
        },
        "region_refinement_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "end_time": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000,
          "default": 600
        },
        "n_procs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8
        }
      }
    }
  },
  "examples": [
    {
      "schema": "cfd-estimate-request/v1",
      "source": {
        "conversion_job_id": "stream_conv_20260917052406_5e76768a"
      },
      "preprocess": {
        "profile": "exterior-wind/v1"
      },
      "wind": {
        "wind_from_degrees": [
          0,
          90
        ],
        "uref_m_s": 5.0,
        "zref_m": 10.0,
        "z0_m": 0.5,
        "true_north_source": "geo_reference"
      },
      "mesh": {},
      "solver": {}
    }
  ]
}
