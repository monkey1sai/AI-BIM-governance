{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim-docs.jackshappybot.com/contracts/cfd-run-request-v1.schema.json",
  "title": "CFD Run Request v1",
  "description": "Body of coordinator POST /api/cfd/runs (browser-facing) and of the internal streaming POST /api/cfd-runs it forwards. The browser never supplies source.model_usdc_sha256; the coordinator fills it from the conversion ledger so the run is bound to one exact model.usdc. Frozen by building-energy-cfd-p2-contract.md S0 (owner decisions 2026-09-21: direction A, run record stays in the streaming job store, the connected appendage structure is included in the shell, a 12% leak fraction on the reference building is accepted).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "idempotency_key",
    "source",
    "preprocess",
    "wind",
    "mesh",
    "solver",
    "requested_by"
  ],
  "properties": {
    "schema": {
      "const": "cfd-run-request/v1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "description": "Same key -> same run_id; the streaming job store replays the existing run instead of creating a second one."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversion_job_id",
        "model_usdc_sha256"
      ],
      "properties": {
        "conversion_job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,200}$"
        },
        "model_usdc_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "preprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "enum": [
            "exterior-wind/v1"
          ]
        },
        "voxel_pitch_m": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0,
          "default": 0.5,
          "x-cfd-setting": {
            "preset": true,
            "engine": null
          }
        },
        "closing_radius_voxels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 4,
          "x-cfd-setting": {
            "preset": true,
            "engine": null
          }
        },
        "leak_fraction_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.15,
          "description": "Runs whose measured leak_fraction exceeds this are still produced but flagged sealing_suspect; owner accepted 0.12 on the reference building, hence the 0.15 default.",
          "x-cfd-setting": {
            "preset": true,
            "engine": null
          }
        }
      }
    },
    "wind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wind_from_degrees",
        "uref_m_s",
        "zref_m",
        "z0_m",
        "true_north_source"
      ],
      "properties": {
        "wind_from_degrees": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "description": "Meteorological: direction the wind blows FROM, degrees clockwise from true north."
        },
        "uref_m_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 40,
          "x-cfd-setting": {
            "preset": false,
            "engine": "uref_m_s",
            "panel": {
              "section": "general",
              "ui_default": 5,
              "step": 0.5,
              "unit": "m/s",
              "label": {
                "zh": "參考風速 U_ref",
                "en": "Reference wind speed U_ref"
              },
              "help": {
                "zh": "參考高度處的風速。",
                "en": "Wind speed at the reference height."
              }
            }
          }
        },
        "zref_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200,
          "x-cfd-setting": {
            "preset": true,
            "engine": "zref_m",
            "panel": {
              "section": "general",
              "step": 1,
              "unit": "m",
              "label": {
                "zh": "參考高度 z_ref",
                "en": "Reference height z_ref"
              },
              "help": {
                "zh": "U_ref 所在的高度，用來建立入流的大氣邊界層剖面。",
                "en": "Height of U_ref; sets the atmospheric boundary-layer inlet profile."
              }
            }
          }
        },
        "z0_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5,
          "x-cfd-setting": {
            "preset": true,
            "engine": "z0_m",
            "panel": {
              "section": "general",
              "step": 0.01,
              "unit": "m",
              "label": {
                "zh": "地表粗糙度 z0",
                "en": "Surface roughness z0"
              },
              "help": {
                "zh": "0.5 m 約為市郊到都市地況；同時影響入流剖面與地面壁函數。",
                "en": "0.5 m is roughly suburban to urban terrain; drives both the inlet profile and the ground wall function."
              }
            }
          }
        },
        "true_north_source": {
          "enum": [
            "geo_reference",
            "manual"
          ],
          "x-cfd-setting": {
            "preset": true,
            "engine": null,
            "panel": {
              "section": "general",
              "label": {
                "zh": "真北來源",
                "en": "True north source"
              },
              "help": {
                "zh": "IFC 沒有可靠真北時，風向會相對 project north。",
                "en": "Without a reliable IFC true north, wind directions are relative to project north."
              },
              "enum_labels": {
                "geo_reference": {
                  "zh": "IFC 定位資料",
                  "en": "IFC geo reference"
                },
                "manual": {
                  "zh": "手動輸入",
                  "en": "Manual"
                }
              }
            }
          }
        },
        "true_north_degrees_manual": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180,
          "x-cfd-setting": {
            "preset": true,
            "engine": null,
            "panel": {
              "section": "general",
              "step": 0.1,
              "unit": "°",
              "label": {
                "zh": "真北角度",
                "en": "True north angle"
              },
              "help": {
                "zh": "由 project north 逆時針轉到真北的角度。",
                "en": "Angle from project north anticlockwise to true north."
              },
              "visible_when": {
                "key": "wind.true_north_source",
                "equals": "manual"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "true_north_source": {
            "const": "manual"
          }
        }
      },
      "then": {
        "required": [
          "true_north_degrees_manual"
        ],
        "properties": {
          "true_north_degrees_manual": {
            "type": "number"
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background_cell_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.5,
          "maximum": 20,
          "x-cfd-setting": {
            "preset": true,
            "engine": "background_cell_m",
            "panel": {
              "section": "advanced",
              "step": 0.25,
              "unit": "m",
              "label": {
                "zh": "背景格大小",
                "en": "Background cell size"
              },
              "help": {
                "zh": "留空為自動：樓高 ÷ 6，限制在 1.5 到 6 m。近建物格是背景格 ÷ 4，加細盒格是背景格 ÷ 2；面板上比例固定，外圍放粗還沒開放到面板。",
                "en": "Empty means automatic: building height / 6, clamped to 1.5-6 m. Near-building cells are background / 4 and refinement-box cells background / 2; on this panel the ratio is fixed, since far-field coarsening is not offered here yet."
              }
            }
          }
        },
        "surface_refinement_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "default": 2,
          "x-cfd-setting": {
            "preset": true,
            "engine": "surface_refinement_level"
          }
        },
        "region_refinement_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1,
          "x-cfd-setting": {
            "preset": true,
            "engine": "region_refinement_level"
          }
        },
        "domain_upstream_h": {
          "type": "number",
          "minimum": 2,
          "maximum": 10,
          "default": 5,
          "x-cfd-setting": {
            "preset": true,
            "engine": "domain_upstream_h"
          }
        },
        "domain_downstream_h": {
          "type": "number",
          "minimum": 5,
          "maximum": 25,
          "default": 15,
          "x-cfd-setting": {
            "preset": true,
            "engine": "domain_downstream_h"
          }
        },
        "domain_lateral_h": {
          "type": "number",
          "minimum": 2,
          "maximum": 10,
          "default": 5,
          "x-cfd-setting": {
            "preset": true,
            "engine": "domain_lateral_h"
          }
        },
        "domain_top_h": {
          "type": "number",
          "minimum": 2,
          "maximum": 10,
          "default": 5,
          "x-cfd-setting": {
            "preset": true,
            "engine": "domain_top_h"
          }
        },
        "max_blockage_ratio": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.1,
          "default": 0.03,
          "x-cfd-setting": {
            "preset": true,
            "engine": "max_blockage_ratio"
          }
        },
        "refinement_box_scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1,
          "x-cfd-setting": {
            "preset": true,
            "engine": "refinement_box_scale"
          }
        },
        "outer_coarsening_levels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0,
          "x-cfd-setting": {
            "preset": true,
            "engine": "outer_coarsening_levels"
          }
        },
        "coarsening_shell_h": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5,
          "default": 1,
          "x-cfd-setting": {
            "preset": true,
            "engine": "coarsening_shell_h"
          }
        },
        "ground_band_height_h": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.05,
          "maximum": 1,
          "default": null,
          "x-cfd-setting": {
            "preset": true,
            "engine": "ground_band_height_h"
          }
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "end_time": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000,
          "default": 600,
          "x-cfd-setting": {
            "preset": true,
            "engine": "end_time",
            "panel": {
              "section": "advanced",
              "step": 50,
              "unit": "",
              "label": {
                "zh": "最大迭代步數 endTime",
                "en": "Maximum iterations (endTime)"
              },
              "help": {
                "zh": "未達收斂時會自動延長一次到 2 倍。",
                "en": "Extended once to twice the value when residual control is not reached."
              }
            }
          }
        },
        "n_procs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8,
          "x-cfd-setting": {
            "preset": false,
            "engine": "n_procs"
          }
        }
      }
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "trace_id"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  },
  "examples": [
    {
      "schema": "cfd-run-request/v1",
      "idempotency_key": "cfdreq_demo_20260921_0001",
      "source": {
        "conversion_job_id": "stream_conv_20260915094906_54813240",
        "model_usdc_sha256": "c29af95f494349290000000000000000000000000000000000000000000000ab"
      },
      "preprocess": {
        "profile": "exterior-wind/v1",
        "voxel_pitch_m": 0.5,
        "closing_radius_voxels": 4,
        "leak_fraction_limit": 0.15
      },
      "wind": {
        "wind_from_degrees": [
          0,
          22.5,
          45
        ],
        "uref_m_s": 5.0,
        "zref_m": 10.0,
        "z0_m": 0.5,
        "true_north_source": "geo_reference",
        "true_north_degrees_manual": null
      },
      "mesh": {
        "background_cell_m": 6.0,
        "surface_refinement_level": 2,
        "region_refinement_level": 1
      },
      "solver": {
        "end_time": 600,
        "n_procs": 8
      },
      "requested_by": {
        "principal": "operator_demo",
        "trace_id": "trace_cfd_demo_0001"
      }
    }
  ]
}
