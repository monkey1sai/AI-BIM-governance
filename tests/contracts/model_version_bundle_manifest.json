{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim-docs.jackshappybot.com/contracts/model-version-bundle-manifest-v1.schema.json",
  "title": "Model Version Bundle Manifest v1",
  "description": "Edge governed source-bundle documents owned by bim-review-coordinator: the MinIO source manifest itself, the coordinator-side validation result, and the two LEGACY_UNMANAGED enrollment documents. Object paths are locators only; edge artifact identity and lineage are decided by the manifest and MUST NOT replace the external cloud tenant/project/model-version/RBAC authority.",
  "$comment": "Source of truth: openspec/changes/rvt-ifc-usdc-lineage/specs/minio-model-version-bundle/spec.md (tasks.md 2.1). Enum spellings are copied verbatim from that spec; do not re-case them. Shared $defs (utcTimestamp / sha256 / locator) are byte-identical copies of openspec/changes/rvt-ifc-usdc-lineage/contracts/cloud-lineage-publication-request-v1.schema.json and are asserted deep-equal by test_shared_defs_are_deep_equal_across_contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "body"
  ],
  "properties": {
    "schema_version": {
      "const": "model-version-bundle-manifest/v1"
    },
    "document_type": {
      "enum": [
        "source_bundle_manifest",
        "source_bundle_validation_result",
        "legacy_unmanaged_preview",
        "legacy_enrollment_confirmation"
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "$comment": "Discriminated branch. `else: false` makes a non-matching branch fail on the discriminator alone, so a body violation is reported once, at its real location, instead of being buried under three sibling branches that also happen to define conditional_create / source_bundle_id.",
      "if": {
        "required": [
          "document_type"
        ],
        "properties": {
          "document_type": {
            "const": "source_bundle_manifest"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/sourceBundleManifest"
          }
        }
      },
      "else": false
    },
    {
      "if": {
        "required": [
          "document_type"
        ],
        "properties": {
          "document_type": {
            "const": "source_bundle_validation_result"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/bundleValidationResult"
          }
        }
      },
      "else": false
    },
    {
      "if": {
        "required": [
          "document_type"
        ],
        "properties": {
          "document_type": {
            "const": "legacy_unmanaged_preview"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/legacyUnmanagedPreview"
          }
        }
      },
      "else": false
    },
    {
      "if": {
        "required": [
          "document_type"
        ],
        "properties": {
          "document_type": {
            "const": "legacy_enrollment_confirmation"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/legacyEnrollmentConfirmation"
          }
        }
      },
      "else": false
    }
  ],
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[1-9][0-9]{3}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "$comment": "Byte-identical copy of the shared cloud-request $defs/locator. Retained here as the single canonical locator object shape for the lineage contract family even though bundle documents carry the flattened per-artifact form; see $defs/bundleArtifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "object_version_id",
        "etag",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^minio://[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[^?#\\s]+\\?versionId=[A-Za-z0-9._~%-]+$",
          "not": {
            "pattern": "[?&][Xx]-[Aa][Mm][Zz]-"
          }
        },
        "object_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifactRole": {
      "enum": [
        "source_rvt",
        "schedule_csv",
        "source_ifc"
      ]
    },
    "minioObjectRef": {
      "$comment": "Same string constraints as $defs/locator.properties.ref, duplicated because bundle artifacts carry the locator fields flattened alongside role/filename/content_type.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^minio://[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[^?#\\s]+\\?versionId=[A-Za-z0-9._~%-]+$",
      "not": {
        "pattern": "[?&][Xx]-[Aa][Mm][Zz]-"
      }
    },
    "bundleProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "producer_kind"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "producer_kind": {
          "enum": [
            "external_ifc_worker",
            "legacy_enrollment"
          ]
        },
        "agent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "bundleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ref",
        "object_version_id",
        "etag",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/artifactRole"
        },
        "ref": {
          "$ref": "#/$defs/minioObjectRef"
        },
        "object_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "sourceBundleManifest": {
      "$comment": "The MinIO manifest.json that is conditional-created LAST, after model.rvt / schedule.csv / model.ifc are complete.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema_version",
        "source_bundle_id",
        "external_model_version_id",
        "producer",
        "created_at",
        "published_at",
        "artifacts"
      ],
      "properties": {
        "manifest_schema_version": {
          "const": "source-bundle-manifest/v1"
        },
        "source_bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "external_model_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "model_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "producer": {
          "$ref": "#/$defs/bundleProducer"
        },
        "created_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "published_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "artifacts": {
          "$comment": "Exactly the three immutable required roles. minItems:3 is not separately isolable: any shorter array necessarily fails one of the three contains clauses.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/bundleArtifact"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "source_rvt"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "schedule_csv"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "source_ifc"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "integrityDiagnosticCode": {
      "$comment": "Closed vocabulary for source-bundle integrity diagnostics (13 codes).",
      "enum": [
        "missing_required_role",
        "duplicate_role",
        "artifact_not_found",
        "artifact_incomplete",
        "etag_mismatch",
        "sha256_mismatch",
        "size_mismatch",
        "manifest_published_before_artifacts",
        "manifest_digest_conflict",
        "unversioned_locator",
        "presigned_locator_forbidden",
        "immutable_bundle_overwrite_rejected",
        "semantic_contract_violation"
      ]
    },
    "integrityDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "role",
        "expected",
        "observed",
        "detail"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/integrityDiagnosticCode"
        },
        "role": {
          "enum": [
            "source_rvt",
            "schedule_csv",
            "source_ifc",
            null
          ]
        },
        "expected": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "observed": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "bundleValidationResult": {
      "$comment": "Coordinator-side independent re-validation outcome. A producer ready claim is never authority; this document is.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bundle_id",
        "external_model_version_id",
        "manifest_sha256",
        "manifest_present",
        "bundle_state",
        "conditional_create",
        "replay",
        "enqueued_pipeline_job_id",
        "integrity_diagnostics",
        "observed_at"
      ],
      "properties": {
        "source_bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "external_model_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "manifest_sha256": {
          "$comment": "null only when manifest_present is false; the READY branch below re-tightens this to a string.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_present": {
          "type": "boolean"
        },
        "bundle_state": {
          "enum": [
            "READY",
            "NON_READY",
            "LEGACY_UNMANAGED"
          ]
        },
        "conditional_create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempted",
            "outcome"
          ],
          "properties": {
            "attempted": {
              "type": "boolean"
            },
            "outcome": {
              "enum": [
                "created",
                "already_exists_same_digest",
                "conflict_different_digest",
                "not_attempted"
              ]
            }
          }
        },
        "replay": {
          "type": "boolean"
        },
        "enqueued_pipeline_job_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "integrity_diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/integrityDiagnostic"
          }
        },
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "allOf": [
        {
          "$comment": "READY requires a present manifest, a real manifest digest, zero integrity diagnostics, and a successful conditional create.",
          "if": {
            "required": [
              "bundle_state"
            ],
            "properties": {
              "bundle_state": {
                "const": "READY"
              }
            }
          },
          "then": {
            "properties": {
              "integrity_diagnostics": {
                "maxItems": 0
              },
              "manifest_present": {
                "const": true
              },
              "manifest_sha256": {
                "type": "string"
              },
              "conditional_create": {
                "properties": {
                  "outcome": {
                    "enum": [
                      "created",
                      "already_exists_same_digest"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "Nothing but READY may hold an enqueued pipeline job.",
          "if": {
            "required": [
              "bundle_state"
            ],
            "properties": {
              "bundle_state": {
                "enum": [
                  "NON_READY",
                  "LEGACY_UNMANAGED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "enqueued_pipeline_job_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "$comment": "NON_READY must state why.",
          "if": {
            "required": [
              "bundle_state"
            ],
            "properties": {
              "bundle_state": {
                "const": "NON_READY"
              }
            }
          },
          "then": {
            "properties": {
              "integrity_diagnostics": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "legacyCandidateArtifact": {
      "$comment": "Derived read-only observation of an unmanifested object; digests may be unknown because preview MUST NOT mutate the store.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ref"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/artifactRole"
        },
        "ref": {
          "$ref": "#/$defs/minioObjectRef"
        },
        "object_version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "etag": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "legacyCandidateMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_artifacts"
      ],
      "properties": {
        "external_model_version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "project_display_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 400
        },
        "model_category": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "candidate_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/legacyCandidateArtifact"
          }
        }
      }
    },
    "legacyDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "difference_kind",
        "candidate_value",
        "governed_value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "difference_kind": {
          "enum": [
            "missing_manifest",
            "missing_artifact",
            "extra_artifact",
            "metadata_mismatch",
            "digest_unknown"
          ]
        },
        "candidate_value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "governed_value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "legacyUnmanagedPreview": {
      "$comment": "Read-only derivation of candidate metadata for an unmanifested grouping. mutates_store is const false: preview MUST NOT write a manifest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grouping_key",
        "state",
        "candidate_metadata",
        "differences",
        "mutates_store",
        "requires_capability",
        "observed_at"
      ],
      "properties": {
        "grouping_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "state": {
          "const": "LEGACY_UNMANAGED"
        },
        "candidate_metadata": {
          "$ref": "#/$defs/legacyCandidateMetadata"
        },
        "differences": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/legacyDifference"
          }
        },
        "mutates_store": {
          "const": false
        },
        "requires_capability": {
          "const": "bundle.publish"
        },
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "legacyEnrollmentConfirmation": {
      "$comment": "Explicit capability-gated promotion of a LEGACY_UNMANAGED grouping. Concurrent confirmations: exactly one conditional create wins; the loser gets a retryable conflict and MUST NOT overwrite the existing manifest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grouping_key",
        "confirmed_by_subject",
        "capability",
        "authorization_decision_ref",
        "confirmed_at",
        "conditional_create",
        "created_source_bundle_id",
        "retryable"
      ],
      "properties": {
        "grouping_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "confirmed_by_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "capability": {
          "const": "bundle.publish"
        },
        "authorization_decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "confirmed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "conditional_create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "created",
                "conflict_existing_manifest"
              ]
            }
          }
        },
        "created_source_bundle_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "conditional_create"
            ],
            "properties": {
              "conditional_create": {
                "required": [
                  "outcome"
                ],
                "properties": {
                  "outcome": {
                    "const": "created"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "created_source_bundle_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "conditional_create"
            ],
            "properties": {
              "conditional_create": {
                "required": [
                  "outcome"
                ],
                "properties": {
                  "outcome": {
                    "const": "conflict_existing_manifest"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "created_source_bundle_id": {
                "type": "null"
              },
              "retryable": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
