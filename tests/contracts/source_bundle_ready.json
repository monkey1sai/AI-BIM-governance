{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim-docs.jackshappybot.com/contracts/source-bundle-ready-v1.schema.json",
  "title": "Source Bundle Ready Intake Payload v1",
  "description": "Additive governed producer intake claim: external IFC Worker -> bim-review-coordinator POST /api/external/source-bundles/ready. This claim identifies a governed source bundle but is NEVER authority; the coordinator independently re-reads and re-validates required roles, refs, ETags, object versions, SHA-256 and sizes before declaring READY. It is not a cloud event, not a browser API, and MUST NOT be routed through the legacy conversion callback path.",
  "$comment": "Source of truth: openspec/changes/rvt-ifc-usdc-lineage/specs/minio-model-version-bundle/spec.md (tasks.md 2.4). Transport: POST /api/external/source-bundles/ready with headers X-Correlation-Id, X-Idempotency-Key, X-Webhook-Secret (intranet-dev AuthProvider shape, identical to the frozen /api/external/ifc-ready transport block). The existing /api/external/ifc-ready contract (tests/contracts/ifc_ready_payload.json v1.1.0) stays unchanged. Shared $defs (utcTimestamp / sha256 / locator) are byte-identical copies of openspec/changes/rvt-ifc-usdc-lineage/contracts/cloud-lineage-publication-request-v1.schema.json. The explicit top-level `not` clause is a redundant, machine-readable declaration of the dual-authority ban: cloud-lineage-publication/v1 and result-publication field names may never appear here, so no reader can mistake this intake payload for a cloud event. additionalProperties:false already rejects them; the `not` clause states the intent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "contract_version",
    "correlation_id",
    "idempotency_key",
    "source_bundle_id",
    "external_model_version_id",
    "tenant_id",
    "project_id",
    "manifest_ref",
    "manifest_sha256",
    "claimed_at",
    "producer"
  ],
  "properties": {
    "event": {
      "const": "source_bundle_ready"
    },
    "contract_version": {
      "const": "source-bundle-ready/v1"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "external_model_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "project_display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "model_category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "manifest_ref": {
      "$ref": "#/$defs/locator"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "claimed_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "producer": {
      "$ref": "#/$defs/bundleProducer"
    }
  },
  "not": {
    "$comment": "No dual authority: cloud publication identity, cloud event envelope fields, result-side refs/summaries and the legacy callback_url are all forbidden here.",
    "anyOf": [
      {
        "required": [
          "schema_version"
        ]
      },
      {
        "required": [
          "event_type"
        ]
      },
      {
        "required": [
          "publication_identity"
        ]
      },
      {
        "required": [
          "result_manifest_digest"
        ]
      },
      {
        "required": [
          "edge_site_id"
        ]
      },
      {
        "required": [
          "callback_url"
        ]
      },
      {
        "required": [
          "result_refs"
        ]
      },
      {
        "required": [
          "alignment_summary"
        ]
      }
    ]
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[1-9][0-9]{3}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "object_version_id",
        "etag",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^minio://[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[^?#\\s]+\\?versionId=[A-Za-z0-9._~%-]+$",
          "not": {
            "pattern": "[?&][Xx]-[Aa][Mm][Zz]-"
          }
        },
        "object_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bundleProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "producer_kind"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "producer_kind": {
          "enum": [
            "external_ifc_worker",
            "legacy_enrollment"
          ]
        },
        "agent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
