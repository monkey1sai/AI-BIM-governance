{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim-docs.jackshappybot.com/contracts/cloud-lineage-publication-response-v1.schema.json",
  "title": "Cloud Lineage Publication Response v1",
  "description": "Success ACK or sanitized error body for POST /api/v1/lineage-publications.",
  "oneOf": [
    {
      "$ref": "#/$defs/successAck"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[1-9][0-9]{3}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "successAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_id",
        "event_id",
        "publication_identity",
        "manifest_digest",
        "stored_at",
        "replay"
      ],
      "properties": {
        "registration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "publication_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 522,
          "pattern": "^[A-Za-z0-9._-]+:[^:]+:[^:]+$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "stored_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "replay": {
          "type": "boolean"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "UNSUPPORTED_SCHEMA",
                "HMAC_AUTH_FAILED",
                "TENANT_BINDING_MISMATCH",
                "PARENT_BINDING_NOT_FOUND",
                "PUBLICATION_DIGEST_CONFLICT",
                "RATE_LIMITED",
                "TRANSIENT_UNAVAILABLE",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": {
                    "enum": [
                      "INVALID_REQUEST",
                      "UNSUPPORTED_SCHEMA",
                      "HMAC_AUTH_FAILED",
                      "TENANT_BINDING_MISMATCH",
                      "PARENT_BINDING_NOT_FOUND",
                      "PUBLICATION_DIGEST_CONFLICT"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "retryable": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "enum": [
                      "RATE_LIMITED",
                      "TRANSIENT_UNAVAILABLE",
                      "INTERNAL_ERROR"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "retryable": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
