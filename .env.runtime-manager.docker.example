# AI-BIM Runtime Manager Docker-first MVP

COMPOSE_PROJECT_NAME=ai-bim-runtime-manager

# PPMS upstream: test data / RVT→IFC source only
PPMS_ENABLED=true
PPMS_BASE_URL=https://ppms.ezplus.com.tw
PPMS_INTERNAL_IP=192.168.20.239
PPMS_API_TOKEN=

# Shared local object/cache roots mounted into containers
RUNTIME_STORAGE_ROOT=./storage
RUNTIME_OBJECTS_ROOT=./.runtime/objects
RUNTIME_JOBS_ROOT=./.runtime/jobs

# Service URLs visible from browser
VITE_KIT_MANAGER_API_BASE=http://127.0.0.1:8010
VITE_VIEWER_URL=http://127.0.0.1:5173
VITE_KIT_SIGNALING_HOST=127.0.0.1
VITE_KIT_SIGNALING_PORT=49100

# Service URLs visible inside Docker network
BIM_CONTROL_URL=http://bim-control:8001
WORKER_URL=http://worker:8005
COORDINATOR_URL=http://coordinator:8004
KIT_MANAGER_API_URL=http://kit-manager-api:8010
KIT_CONTROL_URL=http://streaming-server:49101

# Kit / GPU runtime
KIT_INSTANCE_ID=kit_local_gpu_001
KIT_SIGNALING_PORT=49100
KIT_MEDIA_PORT=47998
KIT_CONTROL_PORT=49101
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute,video

# MVP mode
HOST_LOCAL_RUNTIME_ALLOWED=false
RUNTIME_MODE=docker-container
