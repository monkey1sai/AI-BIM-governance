# Canonical Linux test-deploy sample. Copy to
# `.env.web-plane.host-kit.canonical-linux` and inject real values outside git.
# Documentation addresses and paths below are non-routable placeholders.

COMPOSE_PROJECT_NAME=ai-bim-web-plane-host-kit
COORDINATOR_PORT=8004
VIEWER_PORT=5173
COORDINATOR_INTERNAL_API_BASE=
INTERNAL_API_AUTH_TOKEN=
A4_INTERNAL_CONTEXT_TOKEN=

PUBLIC_HOST=192.0.2.10
VIEWER_BIND_HOST=0.0.0.0
HOST_BRIDGE_PROFILE=linux-host-gateway
HOST_CONVERSION_API_BASE=http://host.docker.internal:49101
HOST_GOVERNANCE_API_BASE=http://host.docker.internal:49102

KIT_SIGNALING_PORT=49100
KIT_MEDIA_PORT=47998
KIT_SPECTATOR_COUNT=5
KIT_SPECTATOR_SIGNALING_PORT_START=49110
KIT_SPECTATOR_MEDIA_PORT_START=48008
KIT_SPECTATOR_PORT_STRIDE=10

STREAMING_CONVERSION_ARTIFACTS_ROOT=/srv/ai-bim/example-runtime-data/host-native-conversion/artifacts
STREAMING_CONVERSION_JOBS_DIR=/srv/ai-bim/example-runtime-data/host-native-conversion/jobs
STREAMING_CONVERSION_PUBLIC_ARTIFACTS_URL=http://192.0.2.10:49101/artifacts
RUNTIME_STORAGE_ROOT=/srv/ai-bim/example-runtime-data/storage
RUNTIME_MODE=hybrid-web-plane-host-native-kit
EDGE_SITE_ID=site-example

MINIO_WATCH_ENABLED=false
MINIO_WATCH_ENDPOINT=https://minio.example.invalid
MINIO_WATCH_BUCKET=bim-control
MINIO_WATCH_PREFIX=
MINIO_WATCH_ACCESS_KEY=
MINIO_WATCH_SECRET_KEY=
MINIO_WATCH_INTERVAL_SECONDS=60
MINIO_WATCH_INTERVAL_FLOOR_SECONDS=
MINIO_WATCH_KEY_SUFFIX=/model.ifc
MINIO_WATCH_TENANT_ID=
MINIO_WATCH_SELF_BASE_URL=

# unified-console-runtime-truth（owner D3 裁決 2026-08-25）：canonical-linux 關閉 coordinator /api/dev/* demo 路由（整組 404）。
ENABLE_DEV_ROUTES=false
# unified-console-runtime-truth（owner D2=T4）：conversion 控制路由 operator token；canonical-linux 必填非預設值（本 template 不放真值，由 owner 私有 env 提供）。
DEV_AUTH_TOKEN=
