<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>vg01-highlight-column-e2e</title>
    </info>
    <specifications>
        <specification name="VG-01 mapped columns require impossible property (E2E)" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOLUMN</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_VG01_E2E</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>MustFailForMappedHighlight</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
    </specifications>
</ids>
