# =============================================================================
# AI-BIM-governance — local env SAMPLE (tracked)
# Lab defaults for Ornith vLLM on LAN. Copy to root `.env` (gitignored) for deploy.
# Reference: ornith-vllm-api-examples.html
# WARNING: This sample includes a lab API key for one-click local deploy convenience.
#          Rotate the key if this repo is shared outside the lab; do not reuse in prod.
# =============================================================================

# --- A4 / Ornith vLLM (OpenAI-compatible) — governance-service process ---
A4_LLM_BASE_URL=
A4_LLM_MODEL=
A4_LLM_TIMEOUT_S=120
A4_LLM_ENABLED=true

# Lab key (same as ornith-vllm-api-examples.html). Aliases: ORNITH_API_KEY or A4_LLM_API_KEY
ORNITH_API_KEY=
# A4_LLM_API_KEY=fc1fb67bc8856b45391170c403bc4209b0a5571322fd7eb0e963d691174f7053

# Optional aliases
# ORNITH_API_BASE=http://192.168.10.248:18080/v1
# ORNITH_MODEL=Ornith-1.0-35B

# --- How to use ---
#   Copy-Item env.sample .env
#   Restart governance-service / deploy.ps1 so process inherits env
# UI: http://127.0.0.1:8004/ui#a4  → interpret_mode=semantic|auto
# Status: GET /api/governance/search/llm-status  (never returns the key)
