# =============================================================================
# AI-BIM-governance — tracked placeholder-only environment sample
# Operator-owned endpoint and credential values must be injected out of repo.
# Reference: docs/runbooks/a4-ornith-llm.md
# =============================================================================

# --- A4 / Ornith vLLM (OpenAI-compatible) — governance-service process ---
A4_LLM_ENABLED=false
A4_LLM_BASE_URL=
A4_LLM_MODEL=
A4_LLM_TIMEOUT_S=120
A4_LLM_PROFILE=
A4_LLM_TRANSPORT_MODE=
A4_LLM_ALLOW_INSECURE=false
A4_LLM_HTTP_ALLOWLIST=

# Credential aliases; keep every tracked value empty.
ORNITH_API_KEY=
# A4_LLM_API_KEY=

# Optional non-secret aliases; keep tracked values empty.
# ORNITH_API_BASE=
# ORNITH_MODEL=
# ORNITH_PROFILE=
# ORNITH_TRANSPORT_MODE=

# --- How to use ---
# Copy this file only when no local .env exists, then provision operator-owned
# values through the approved out-of-repo mechanism. Never overwrite a real .env.
# UI: http://127.0.0.1:8004/ui#/workspace?dock=a4
# Status: GET /api/governance/search/llm-status (never returns endpoint or key)
