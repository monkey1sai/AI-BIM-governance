# =============================================================================
# AI-BIM-governance — local env SAMPLE (tracked)
# Copy to root `.env` (gitignored) and fill secrets. Do NOT commit real keys.
# Source of truth for A4 Ornith defaults: ornith-vllm-api-examples.html (LAN host)
# =============================================================================

# --- A4 / Ornith vLLM (OpenAI-compatible) — governance-service process ---
# Base URL / model are safe local defaults for this LAN lab.
A4_LLM_BASE_URL=http://192.168.10.248:18080/v1
A4_LLM_MODEL=Ornith-1.0-35B
A4_LLM_TIMEOUT_S=120
# true|false|omit — omit means "enable when key is set"
A4_LLM_ENABLED=true

# API key: set in untracked `.env` only. Leave empty in sample.
# Aliases accepted by code: ORNITH_API_KEY or A4_LLM_API_KEY
ORNITH_API_KEY=
# A4_LLM_API_KEY=

# Optional aliases (same semantics)
# ORNITH_API_BASE=http://192.168.10.248:18080/v1
# ORNITH_MODEL=Ornith-1.0-35B

# --- How to use (PowerShell session) ---
#   Copy-Item env.sample .env
#   # edit .env → set ORNITH_API_KEY=...
#   # ensure governance-service inherits env (deploy / start script / process env)
# UI: http://127.0.0.1:8004/ui#a4  → interpret_mode=semantic|auto
# Status: GET /api/governance/search/llm-status  (never returns the key)
