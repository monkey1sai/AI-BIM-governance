{
    "name": "@nvidia/web-viewer-sample",
    "version": "1.5.2",
    "description": "Sample application to showcase streaming of Omniverse Kit applications to a web client application.",
    "author": "Nvidia",
    "license": "SEE LICENSE IN LICENSE",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.0.0",
        "npm": "^10.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "verify": "npm run build && npm run test && npm run test:struct-log",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:session-first": "node scripts/verify-session-first-contract.mjs",
        "test:conversion-summary-card": "node scripts/verify-conversion-summary-card.mjs",
        "test:tri-ready-states": "node scripts/verify-tri-ready-states.mjs",
        "test:struct-log": "node scripts/verify-struct-log.mjs"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ],
        "globals": {
            "GFN": "readonly"
        }
    },
    "dependencies": {
        "@nvidia/omniverse-webrtc-streaming-library": "^5.6.0",
        "bootstrap": "^5.3.3",
        "prop-types": "^15.8.1",
        "react": "^18.2.0",
        "react-bootstrap": "^2.9.1",
        "react-dom": "^18.2.0",
        "socket.io-client": "^4.8.1",
        "vite-plugin-externals": "^0.6.2"
    },
    "devDependencies": {
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^8.55.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "jsdom": "^24.1.0",
        "typescript": "^5.2.2",
        "vite": "^5.0.8",
        "vitest": "^1.6.0"
    }
}
