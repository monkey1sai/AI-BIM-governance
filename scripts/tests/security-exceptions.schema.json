{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "security-exceptions.schema.json",
  "title": "Security exceptions v1",
  "type": "object",
  "required": ["schema_version", "exceptions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "security-exceptions/v1" },
    "exceptions": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "gate_id", "rule_id", "finding_fingerprint", "exact_scope", "owner", "reason", "created_on", "expires_on"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "gate_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "finding_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "exact_scope": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*\\*)(?!.*\\.\\.)(?!.*(?:BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9_]{30,}|github_pat_[A-Za-z0-9_]{50,}|xox[baprs]-[A-Za-z0-9-]+))[^\\u0000-\\u001f\\u007f]+$" },
          "owner": { "type": "string", "minLength": 2, "maxLength": 100, "pattern": "^(?!.*(?:BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9_]{30,}|github_pat_[A-Za-z0-9_]{50,}|xox[baprs]-[A-Za-z0-9-]+))(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$" },
          "reason": { "type": "string", "minLength": 8, "maxLength": 300, "pattern": "^(?!.*(?:BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9_]{30,}|github_pat_[A-Za-z0-9_]{50,}|xox[baprs]-[A-Za-z0-9-]+))(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$" },
          "created_on": { "type": "string", "format": "date" },
          "expires_on": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
