{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-coding-metrics-policy.schema.json",
  "title": "AI coding metrics policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "baseline", "retention", "merge_truth", "diagnostic_retry", "privacy", "registry", "metrics"],
  "properties": {
    "schema_version": { "const": "ai-coding-metrics-policy/v1" },
    "authority": { "const": "telemetry_only" },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["started_on", "minimum_days", "historical_backfill", "capture_provenance", "readiness_gate", "improvement_targets"],
      "properties": {
        "started_on": { "const": "2026-07-28" },
        "minimum_days": { "const": 28 },
        "historical_backfill": { "const": "forbidden" },
        "capture_provenance": { "const": "unattested" },
        "readiness_gate": { "const": "hosted-attested-capture-required" },
        "improvement_targets": { "type": "null" }
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_observations_days", "monthly_aggregate_identity", "enforcement", "not_configured_reason"],
      "properties": {
        "raw_observations_days": { "const": 35 },
        "monthly_aggregate_identity": { "const": "package_only" },
        "enforcement": { "const": "not_configured" },
        "not_configured_reason": { "const": "hosted-retention-unverified" }
      }
    },
    "merge_truth": {
      "type": "object", "additionalProperties": false,
      "required": ["required_retry_count", "telemetry_is_merge_authority"],
      "properties": {
        "required_retry_count": { "const": 0 },
        "telemetry_is_merge_authority": { "const": false }
      }
    },
    "diagnostic_retry": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "maximum_retries", "raw_trace_storage"],
      "properties": {
        "enabled": { "const": true },
        "maximum_retries": { "const": 1 },
        "raw_trace_storage": { "const": "forbidden" }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["stored_envelope_fields", "stored_record_fields", "forbidden_fields"],
      "properties": {
        "stored_envelope_fields": { "$ref": "#/definitions/fieldNames" },
        "stored_record_fields": { "$ref": "#/definitions/fieldNames" },
        "forbidden_fields": { "$ref": "#/definitions/fieldNames" }
      }
    },
    "registry": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["package_id", "gate_id", "test_ids"],
        "properties": {
          "package_id": { "$ref": "#/definitions/id" },
          "gate_id": { "$ref": "#/definitions/id" },
          "test_ids": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } }
        }
      }
    },
    "metrics": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state", "reason"],
        "properties": {
          "id": { "type": "string", "enum": ["first-pass-gate-yield", "change-to-fast-check-ms", "rework-commit-count", "active-change-wip", "active-change-age-days", "context-packet-size", "flake-rate"] },
          "state": { "type": "string", "enum": ["collecting_baseline", "snapshot_only", "not_configured"] },
          "reason": { "$ref": "#/definitions/id" }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "fieldNames": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } }
  }
}
