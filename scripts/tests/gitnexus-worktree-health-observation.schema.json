{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/gitnexus-worktree-health-observation.schema.json",
  "title": "GitNexus and worktree health observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_name", "current_checkout", "worktrees", "gitnexus"],
  "properties": {
    "schema_version": {"const": "gitnexus-worktree-health-observation/v1"},
    "repository_name": {"$ref": "#/definitions/name"},
    "current_checkout": {"$ref": "#/definitions/current_checkout"},
    "worktrees": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/definitions/worktree"}},
    "gitnexus": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/gitnexus"}]}
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"},
    "nullable_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/sha"}]},
    "nullable_branch": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f]+$"}]},
    "current_checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "head_sha", "origin_main_sha", "branch", "dirty"],
      "properties": {
        "path": {"$ref": "#/definitions/path"},
        "head_sha": {"$ref": "#/definitions/sha"},
        "origin_main_sha": {"$ref": "#/definitions/nullable_sha"},
        "branch": {"$ref": "#/definitions/nullable_branch"},
        "dirty": {"type": "boolean"}
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "head_sha", "branch", "dirty", "locked", "prunable", "owner", "owner_status", "last_activity"],
      "properties": {
        "path": {"$ref": "#/definitions/path"},
        "head_sha": {"$ref": "#/definitions/sha"},
        "branch": {"$ref": "#/definitions/nullable_branch"},
        "dirty": {"type": ["boolean", "null"]},
        "locked": {"type": "boolean"},
        "prunable": {"type": "boolean"},
        "owner": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]+$"}]},
        "owner_status": {"enum": ["active", "idle", "ended", "unclaimed", "unknown"]},
        "last_activity": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time", "maxLength": 64}]}
      },
      "allOf": [
        {
          "if": {"properties": {"owner": {"type": "null"}}},
          "then": {"properties": {"owner_status": {"enum": ["unclaimed", "unknown"]}}}
        }
      ]
    },
    "gitnexus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "indexed_path", "indexed_commit", "fts_status", "registrations"],
      "properties": {
        "status": {"enum": ["healthy", "stale", "unavailable", "unknown"]},
        "indexed_path": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/path"}]},
        "indexed_commit": {"$ref": "#/definitions/nullable_sha"},
        "fts_status": {"enum": ["healthy", "missing", "degraded", "unknown"]},
        "registrations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {"name": {"$ref": "#/definitions/name"}, "path": {"$ref": "#/definitions/path"}}
          }
        }
      }
    }
  }
}
