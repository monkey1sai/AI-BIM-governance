{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "merge-evidence-report.schema.json",
  "title": "Required merge evidence report v1",
  "type": "object",
  "required": [
    "schema_version", "result", "authority", "base_sha", "subject_sha", "source_run_id",
    "plan_sha256", "semantic_validation", "completion_eligible", "full_completion", "summary", "outcomes", "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "merge-evidence-report/v1" },
    "result": { "type": "string", "enum": ["prevalidated", "passed", "failed", "bootstrap_only", "input_error"] },
    "authority": { "type": "string", "enum": ["trusted_base", "trusted_main", "bootstrap_untrusted", "unavailable"] },
    "base_sha": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{40}$" }] },
    "subject_sha": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{40}$" }] },
    "source_run_id": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
    "plan_sha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
    "semantic_validation": { "type": "string", "enum": ["pending", "complete", "failed"] },
    "completion_eligible": { "type": "boolean" },
    "full_completion": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["target_count", "required_count", "typed_skip_count", "error_count"],
      "additionalProperties": false,
      "properties": {
        "target_count": { "type": "integer", "minimum": 0, "maximum": 100 },
        "required_count": { "type": "integer", "minimum": 0, "maximum": 100 },
        "typed_skip_count": { "type": "integer", "minimum": 0, "maximum": 100 },
        "error_count": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "outcomes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["target_id", "ci_job", "required", "plan_reason", "job_conclusion", "evidence_result", "semantic_validation_required"],
        "additionalProperties": false,
        "properties": {
          "target_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "ci_job": { "type": "string", "minLength": 1, "maxLength": 200 },
          "required": { "type": "boolean" },
          "plan_reason": { "type": "string", "maxLength": 100 },
          "job_conclusion": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 30 }] },
          "evidence_result": { "type": "string", "enum": ["passed", "incomplete", "typed_skip", "not_required", "overrun", "failed"] },
          "semantic_validation_required": { "type": "boolean" }
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["code", "target_id", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "artifact_duplicate", "artifact_hash_mismatch", "artifact_invalid", "artifact_missing",
              "artifact_stale", "bootstrap_not_authoritative", "design_scope_invalid", "input_invalid",
              "job_conclusion_invalid", "job_duplicate", "job_missing", "plan_mismatch", "plan_not_planned",
              "self_change_requires_two_phase", "semantic_validation_invalid", "source_run_invalid", "subject_mismatch"
            ]
          },
          "target_id": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 64 }] },
          "message": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
