{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verification-plan.schema.json",
  "title": "Verification plan v2",
  "type": "object",
  "required": ["schema_version", "manifest_version", "base_sha", "subject_sha", "result", "dispatch", "changed_paths", "unknown_paths", "targets", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "verification-plan/v2" },
    "manifest_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "base_sha": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      ]
    },
    "subject_sha": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      ]
    },
    "result": { "type": "string", "enum": ["planned", "fail_closed", "input_error"] },
    "dispatch": { "type": "string", "enum": ["affected", "full", "profile", "none"] },
    "changed_paths": { "$ref": "#/definitions/paths" },
    "unknown_paths": { "$ref": "#/definitions/paths" },
    "targets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "owner", "required", "reason", "ci_output", "ci_job", "result_artifact", "gates"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
          "required": { "type": "boolean" },
          "reason": {
            "type": "string",
            "enum": ["affected_path", "docs_only", "full_dispatch_requested", "full_dispatch_self_change", "path_not_affected", "profile_default", "profile_not_selected", "unknown_path_fail_closed"]
          },
          "ci_output": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
            ]
          },
          "ci_job": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()\\-]{0,199}$" },
          "result_artifact": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/definitions/result_artifact" }
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/definitions/gate" }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["code", "field", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": ["changed_path_invalid", "changed_path_required", "input_invalid_json", "input_untrusted", "invalid_argument", "manifest_schema_invalid", "manifest_semantic_invalid", "profile_invalid", "unexpected_failure"]
          },
          "field": { "type": "string", "minLength": 1, "maxLength": 200 },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "gate": {
      "type": "object",
      "required": ["id", "capabilities", "enforcement", "command", "cwd", "evidence_class", "configured", "not_configured_reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["types", "lint", "unit", "contract", "build", "static-analysis", "deployment-contract", "visual", "runtime", "secret", "dependency", "sast", "changed-lines-coverage"] } },
        "enforcement": { "type": "string", "enum": ["required", "advisory"] },
        "command": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["executable", "args"], "additionalProperties": false,
              "properties": { "executable": { "type": "string", "enum": ["docker", "npm", "npx", "pwsh", "python"] }, "args": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 500 } } } }
          ]
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_class": { "type": "string", "enum": ["fast", "contract", "slow", "security"] },
        "configured": { "type": "boolean" },
        "not_configured_reason": { "oneOf": [{ "type": "null" }, { "type": "string", "enum": ["tooling_absent", "coverage_instrumentation_absent", "host_runtime_required", "hosted_capability_unverified", "deployment_pipeline_absent"] }] }
      },
      "allOf": [
        {
          "if": { "properties": { "configured": { "const": true } }, "required": ["configured"] },
          "then": { "properties": { "command": { "type": "object" }, "not_configured_reason": { "type": "null" } } }
        },
        {
          "if": { "properties": { "configured": { "const": false } }, "required": ["configured"] },
          "then": { "properties": { "command": { "type": "null" }, "not_configured_reason": { "type": "string", "enum": ["tooling_absent", "coverage_instrumentation_absent", "host_runtime_required", "hosted_capability_unverified", "deployment_pipeline_absent"] } } }
        }
      ]
    },
    "result_artifact": {
      "type": "object",
      "required": ["artifact_name_prefix", "result_path", "kind", "schema_version", "subject_field"],
      "additionalProperties": false,
      "properties": {
        "artifact_name_prefix": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-$", "maxLength": 100 },
        "result_path": { "type": "string", "pattern": "^artifacts/e2e/(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))(?!.*\\\\)[^\\u0000]+$", "maxLength": 300 },
        "kind": { "type": "string", "enum": ["ai-bim-design-system-visual-result", "ai-bim-functional-runtime-result"] },
        "schema_version": { "type": "integer", "enum": [1, 2] },
        "subject_field": { "const": "subject_commit" }
      }
    }
  }
}
