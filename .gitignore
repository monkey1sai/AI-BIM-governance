# ----------------------------
# Omniverse / Kit generated files
# ----------------------------
bim-streaming-server/_build/
bim-streaming-server/_compiler/
bim-streaming-server/_repo/
bim-streaming-server/_install/
bim-streaming-server/_deps/
bim-streaming-server/_cache/
bim-streaming-server/extscache/
bim-streaming-server/cache/
bim-streaming-server/logs/
# defence-in-depth:bim-streaming-server/.gitignore 已涵蓋 *.etl(含寫到 cwd 的);此為備援,防 sub-repo .gitignore 被移除時 .etl 仍被忽略
bim-streaming-server/*.etl
bim-streaming-server/kit/logs/

# ----------------------------
# Local conversion jobs
# ----------------------------
_conversion-service/data/jobs/
_conversion-service/data/work/
_conversion-service/data/logs/
_conversion-service/jobs/
_worker/data/
_worker/pytest-cache-files-*/
_bim-control/pytest-cache-files-*/
bim-review-coordinator/data/

# ----------------------------
# Fake storage generated outputs
# Keep fixtures separately if needed.
# ----------------------------
_s3_storage/tmp/
_s3_storage/uploads/
_s3_storage/generated/
_s3_storage/static/projects/

# Large BIM artifacts - prefer Git LFS or keep only small fixtures
*.rvt
*.dwg
*.dxf
*.ifc
*.ifczip
*.usd
*.usda
*.usdc
*.usdz
*.glb
*.gltf

# Allow explicitly tracked tiny test fixtures if needed
!_fixtures/**/*.ifc
!_fixtures/**/*.usd
!_fixtures/**/*.usda
!_fixtures/**/*.usdc
!_fixtures/**/*.json

# ----------------------------
# Roadmap / plan HTML derived views (spec: documentation-source-of-truth)
# Generated HTML views stay on-demand only. The interactive governance
# prototype below is tracked because it is a source artifact, not a derived view.
# ----------------------------
docs/plans/*.html
!docs/plans/ai-bim-governance-prototype.html

# ----------------------------
# OpenSpec apply worktrees (opsx-worktree-provision)
# ----------------------------
.worktrees/

# Ignore storage files by default
storage/*
