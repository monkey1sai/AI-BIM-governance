# ----------------------------
# General
# ----------------------------
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak

# Cross-service structured log baseline sink root (per
# docs/contracts/structured-log-schema.md §6.1). Adapters write
# logs/<service>/<YYYY-MM-DD>/<service>-<run_id>.jsonl here.
# The match is broad because tests in bim-review-coordinator/ run with cwd
# inside that sub-repo, producing bim-review-coordinator/logs/.
/logs/
/bim-review-coordinator/logs/
/web-viewer-sample/logs/
/scripts/logs/

# Local runtime-manager env (real values; .env.runtime-manager.docker.example stays tracked)
.env.runtime-manager.docker
.agents/
.claude/*
!.claude/skills/
.claude/skills/*
# Tracked closed-loop automation skills (2026-05-13)
!.claude/skills/closed-loop-orchestrator/
!.claude/skills/change-id-resolve/
!.claude/skills/openspec-explore-twice/
!.claude/skills/gitnexus-blast-radius/
!.claude/skills/apply-and-verify/
!.claude/skills/pr-review-gate/
!.claude/skills/archive-and-closeout/
!.claude/skills/opsx-worktree-provision/
!.claude/skills/opsx-worktree-guard/
# Tracked per-item ship-cycle workflow (2026-06-03)
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/ship-item.md
!.claude/workflows/ship-item.js
.codex/
.vscode/
.gitnexus/
**/.gitnexus/
.playwright-cli/
output/playwright/
graphify-out/
scripts/.run/
pytest-bim-worker-tmp/
pytest-python-manual/
pytest-manual-check/
pytest-bim-control-*.tmp/

