{
  "$schema": "./trusted-host-merge.contract.schema.json",
  "schema_version": "trusted-host-merge/v1",
  "schemas": {
    "broker_assertion": "./trusted-host-merge-assertion.schema.json",
    "apex_evidence": "./trusted-host-merge-evidence.schema.json",
    "apex_verdict": "./trusted-host-merge-verdict.schema.json",
    "terminal_result": "./trusted-host-merge-result.schema.json"
  },
  "repository": {
    "full_name": "monkey1sai/AI-BIM-governance",
    "base_branch": "main",
    "workflow_path": ".github/workflows/trusted-elevated-merge.yml"
  },
  "activation": {
    "state_contract": "./spec-to-done.contract.json",
    "pending_state": "requires_live_attestation",
    "active_state": "active",
    "external_mode_variable": "TRUSTED_MERGE_ACTIVATION_MODE",
    "attestation_tuple_sha256_variable": "TRUSTED_MERGE_ATTESTATION_TUPLE_SHA256",
    "pending_modes": ["attesting_negative", "attesting_positive"],
    "active_mode": "active",
    "attestation_tuple_fields": [
      "repo",
      "prNumber",
      "headOid",
      "baseOid",
      "action",
      "activationMode",
      "provider"
    ]
  },
  "broker": {
    "kind": "github-protected-environment",
    "environment": "trusted-elevated-merge",
    "required_reviewer": {
      "login": "monkey1sai-blip",
      "id": 311287868,
      "type": "User",
      "permission": "write",
      "role_name": "write"
    },
    "prevent_self_review": true,
    "admins_can_bypass": false,
    "deployment_branch_policy": {
      "protected_branches": false,
      "custom_branch_policies": true,
      "allowed_branch": "main"
    },
    "assertion": {
      "kind": "ai-bim-trusted-elevated-merge",
      "version": 1,
      "action": "merge-elevated",
      "max_lifetime_seconds": 900,
      "nonce_pattern": "^[A-Za-z0-9_-]{32,128}$",
      "fields": [
        "kind",
        "version",
        "repo",
        "prNumber",
        "headOid",
        "baseOid",
        "action",
        "runId",
        "activationMode",
        "provider",
        "nonce",
        "expiresAt"
      ]
    }
  },
  "executor": {
    "source": "default-branch-workflow-dispatch",
    "run_attempt": 1,
    "candidate_execution": "forbidden",
    "reviewer_buffer_seconds": 90,
    "evidence_max_bytes": 500000,
    "merge_method": "merge",
    "toolchain": {
      "platform": "linux",
      "node_version": "v20.20.2"
    },
    "irreversible_sink_min_ttl_seconds": 60,
    "merge_request_timeout_milliseconds": 10000,
    "closeout_fetch_timeout_milliseconds": 10000,
    "pre_sink_timeouts": {
      "snapshot_milliseconds": 60000,
      "snapshot_read_count": 5,
      "candidate_fetch_milliseconds": 30000,
      "pr_body_contract_milliseconds": 60000,
      "app_token_mint_milliseconds": 10000,
      "apex_request_milliseconds": 600000,
      "workflow_job_milliseconds": 1800000,
      "result_persistence_reserve_milliseconds": 60000
    },
    "post_merge_observation": {
      "attempts": 4,
      "interval_milliseconds": 1000,
      "request_timeout_milliseconds": 3000
    },
    "required_check_sources": [
      { "context": "agent-governance", "app_id": 15368, "verification_target": "agent-governance", "workflow_path": ".github/workflows/agent-governance.yml" },
      { "context": "root contracts and fakes", "app_id": 15368, "verification_target": "root-contracts", "workflow_path": ".github/workflows/ci.yml" },
