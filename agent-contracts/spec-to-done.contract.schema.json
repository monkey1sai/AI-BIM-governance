{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spec-to-done.contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phases", "durable_state", "terminal_evidence", "ship"],
  "definitions": {
    "newRunCounterResets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentCalls", "p5Rounds", "evidenceAttempts"],
      "properties": {
        "agentCalls": { "const": "0/40" },
        "p5Rounds": { "const": "0/2" },
        "evidenceAttempts": { "const": "0/2" }
      }
    },
    "newRunFieldResets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planPath", "taskIndex", "prNumber", "runIds", "evidenceHead"],
      "properties": {
        "planPath": { "const": "" },
        "taskIndex": { "const": "0" },
        "prNumber": { "const": "" },
        "runIds": { "const": "none" },
        "evidenceHead": { "const": "" }
      }
    },
    "newRunGitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_policy", "executable_path", "executable_sha256",
        "executable_bytes", "git_directory", "git_common_directory"
      ],
      "properties": {
        "executable_policy": { "const": "system-owned-read-only" },
        "executable_path": { "const": "required" },
        "executable_sha256": { "const": "required" },
        "executable_bytes": { "const": "required" },
        "git_directory": { "const": "required" },
        "git_common_directory": { "const": "required" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "spec-to-done-contract/v1" },
    "phases": {
      "const": ["P0", "P1", "P3", "P4", "P5", "P6", "P7"]
    },
    "durable_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_relative_path", "new_run_boundary", "held_reasons"],
      "properties": {
        "canonical_relative_path": {
          "const": "artifacts/spec-to-done/{slug}-state.md"
        },
        "new_run_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "token", "required_previous_reason",
            "owner_provenance", "git_identity", "counter_resets", "field_resets"
          ],
          "properties": {
            "schema_version": { "const": "spec-to-done-new-run/v1" },
            "token": { "const": "NEW_RUN@P0" },
            "required_previous_reason": { "const": "run_budget_exhausted" },
            "owner_provenance": { "const": "sha256-tuple-binding-not-digital-signature" },
            "git_identity": { "$ref": "#/definitions/newRunGitIdentity" },
            "counter_resets": { "$ref": "#/definitions/newRunCounterResets" },
            "field_resets": { "$ref": "#/definitions/newRunFieldResets" }
          }
        },
        "held_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "terminal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_phase",
        "trusted_remote_url",
        "remote_main_ref",
        "live_remote_resolution",
        "pr_head_ancestor_of_merge_commit",
        "merge_commit_equals_remote_main",
        "pr_head_and_merge_commit_same_tree"
      ],
      "properties": {
        "owner_phase": { "const": "P7" },
        "trusted_remote_url": {
          "const": "https://github.com/monkey1sai/AI-BIM-governance.git"
        },
        "remote_main_ref": { "const": "refs/heads/main" },
        "live_remote_resolution": { "const": "required" },
        "pr_head_ancestor_of_merge_commit": { "const": "required" },
        "merge_commit_equals_remote_main": { "const": "required" },
        "pr_head_and_merge_commit_same_tree": { "const": "required" }
      }
    },
    "ship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_shell_capability",
        "trusted_host_executor",
        "trusted_host_contract",
        "trusted_host_workflow",
        "dispatch_protocol",
        "activation_state",
        "unavailable_reason",
        "arbiter_held_reasons"
      ],
      "properties": {
        "workflow_shell_capability": {
          "const": "not_available_in_measured_runtime"
        },
        "trusted_host_executor": { "const": "implemented_external_workflow" },
        "trusted_host_contract": { "const": "./trusted-host-merge.contract.json" },
        "trusted_host_workflow": { "const": ".github/workflows/trusted-elevated-merge.yml" },
        "dispatch_protocol": { "const": "github-workflow-dispatch" },
        "activation_state": { "enum": ["requires_live_attestation", "active"] },
        "unavailable_reason": {
          "enum": ["trusted_elevated_authorization_unavailable", "host_env_blocked"]
        },
        "arbiter_held_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
