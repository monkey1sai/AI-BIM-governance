{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec-to-done-fabric-binding.schema.json",
  "title": "spec-to-done Parallel Delivery Fabric binding",
  "description": "Closed, non-secret and non-authorizing binding between one Fabric task lease and one single-writer spec-to-done delivery slice. Repo session admission remains unbounded by writer count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "slug",
    "fabric_tuple",
    "lease_state_at_binding",
    "source_digests",
    "task_scope_resources",
    "allowed_paths",
    "state_relative_path",
    "binding_relative_path",
    "capacity_semantics",
    "recovery_policy",
    "delivery_authority"
  ],
  "properties": {
    "schema_version": { "const": "spec-to-done-fabric-binding/v1" },
    "binding_id": { "$ref": "#/$defs/sha256" },
    "slug": { "$ref": "#/$defs/slug" },
    "fabric_tuple": { "$ref": "#/$defs/fabric_tuple" },
    "lease_state_at_binding": { "const": "ACTIVE" },
    "source_digests": { "$ref": "#/$defs/source_digests" },
    "task_scope_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/scope_resource" }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repository_path" }
    },
    "state_relative_path": {
      "allOf": [
        { "$ref": "#/$defs/repository_path" },
        { "pattern": "^artifacts/spec-to-done/[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{64}-state\\.md$" }
      ]
    },
    "binding_relative_path": {
      "allOf": [
        { "$ref": "#/$defs/repository_path" },
        { "pattern": "^artifacts/spec-to-done/bindings/[0-9a-f]{64}\\.json$" }
      ]
    },
    "capacity_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_admission_limit",
        "run_writer_cardinality",
        "requested_capacity_writers",
        "activation_writer_cap"
      ],
      "properties": {
        "session_admission_limit": { "const": "unbounded" },
        "run_writer_cardinality": { "const": 1 },
        "requested_capacity_writers": { "const": "plan_local_request_only" },
        "activation_writer_cap": { "const": "review_or_direct_stack_only" }
      }
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "held_lease_action",
        "local_new_run_allowed",
        "local_resume_allowed",
        "verified_resume_intent_required"
      ],
      "properties": {
        "held_lease_action": { "const": "retain_as_suspect" },
        "local_new_run_allowed": { "const": false },
        "local_resume_allowed": { "const": false },
        "verified_resume_intent_required": { "const": true }
      }
    },
    "delivery_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "push",
        "approve",
        "merge",
        "deploy",
        "process_termination",
        "branch_protection_mutation",
        "review_migration",
        "direct_stack"
      ],
      "properties": {
        "push": { "const": false },
        "approve": { "const": false },
        "merge": { "const": false },
        "deploy": { "const": false },
        "process_termination": { "const": false },
        "branch_protection_mutation": { "const": false },
        "review_migration": { "const": false },
        "direct_stack": { "const": false }
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "opaque_reference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._:/-]{0,119}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*[\\\\/]{2})(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[^\\u0000\\r\\n*?\\[\\]{}]+$"
    },
    "repository_glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*[\\\\/]{2})(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[^\\u0000\\r\\n]+$"
    },
    "resource_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._:/-]{0,247}$"
    },
    "path_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "path" },
        "path": { "$ref": "#/$defs/repository_path" }
      }
    },
    "glob_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pattern"],
      "properties": {
        "kind": { "const": "glob" },
        "pattern": { "$ref": "#/$defs/repository_glob" }
      }
    },
    "rename_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "old_path", "new_path"],
      "properties": {
        "kind": { "const": "rename" },
        "old_path": { "$ref": "#/$defs/repository_path" },
        "new_path": { "$ref": "#/$defs/repository_path" }
      }
    },
    "shared_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource_key"],
      "properties": {
        "kind": {
          "enum": ["shared_contract", "exported_symbol", "schema", "event", "migration", "runtime"]
        },
        "resource_key": { "$ref": "#/$defs/resource_key" }
      }
    },
    "scope_resource": {
      "oneOf": [
        { "$ref": "#/$defs/path_resource" },
        { "$ref": "#/$defs/glob_resource" },
        { "$ref": "#/$defs/rename_resource" },
        { "$ref": "#/$defs/shared_resource" }
      ]
    },
    "fabric_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "generation",
        "task_id",
        "lease_id",
        "owner_session",
        "provider",
        "scope_digest",
        "baseline_sha",
        "branch",
        "worktree_path_digest"
      ],
      "properties": {
        "plan_id": { "$ref": "#/$defs/opaque_reference" },
        "generation": { "type": "integer", "minimum": 1 },
        "task_id": { "$ref": "#/$defs/opaque_reference" },
        "lease_id": { "$ref": "#/$defs/opaque_reference" },
        "owner_session": { "$ref": "#/$defs/opaque_reference" },
        "provider": { "enum": ["codex", "claude"] },
        "scope_digest": { "$ref": "#/$defs/sha256" },
        "baseline_sha": { "$ref": "#/$defs/sha1" },
        "branch": { "$ref": "#/$defs/branch" },
        "worktree_path_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "task", "lease", "provider_session"],
      "properties": {
        "plan": { "$ref": "#/$defs/sha256" },
        "task": { "$ref": "#/$defs/sha256" },
        "lease": { "$ref": "#/$defs/sha256" },
        "provider_session": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
