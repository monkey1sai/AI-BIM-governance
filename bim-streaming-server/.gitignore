# All folders starting with _ are local.
_*/

# Compiled python files.
*.py[cod]
*.pyc
__pycache__/

# Visual Studio files.
/.vs
**/.vscode/ipch

# macOS files.
.DS_Store

# Generated license file.
PACKAGE-DEPS.yaml

# packman .user config
*.packman.xml.user

# kit user config
deps/**/user.toml

# vscode settings are copied and filled in from 'settings.json.template'
.vscode/settings.json

# PyCharm files.
/.idea/

# Linux in docker build $HOME dirs
/.nvidia-omniverse
/.local
/.cache

# Omniverse EULA breadcrumb
/.omniverse_eula_accepted.txt

# Streaming EventTrace
*.etli
*.etl
logs/

# Stray dir created when %SystemDrive% env var failed to expand under bash/MSYS
# (Kit / NvStreamer subprocess wrote to "%SystemDrive%\ProgramData\..." literally
# while cwd was the repo root). Local artifact only — never enter version control.
/%SystemDrive%/

# Keep generated template metadata out of version control, but track app/extension sources.
/source/*
!/source/apps/
!/source/apps/**
!/source/extensions/
!/source/extensions/**
# Runtime structured-log sink (cross-service log baseline) writes JSONL runs
# under the messaging extension while the service is live; the extensions
# negation above would otherwise re-track it and break clean-tree gates.
/source/extensions/ezplus.bim_review_stream.messaging/ezplus/bim_review_stream/messaging/logs/
/source/**/__pycache__/
/source/**/__pycache__/**
/source/**/*.pyc
/source/rendered_template_metadata.json


# Local agent / browser automation artifacts
/.claude/
/.playwright-mcp/
# /CLAUDE.md un-ignored 2026-07-02（治理審計：薄鏡像入版控，PR review 可見）
/current-stream-*.png
/stream-validation-*.png
/.codex
/.codex

# BIM Streaming - USD model artifacts (per docs/plan-bim-ifc-usd-streaming-2026-04-27.md)
/bim-models/*
!/bim-models/.gitkeep
!/bim-models/README.md
*.usd
*.usda
*.usdc
*.usdz
!/source/apps/**/*.usd
!/source/apps/**/*.usda
!/source/apps/**/*.usdc
!/source/apps/**/*.usdz
!/source/extensions/**/*.usd
!/source/extensions/**/*.usda
!/source/extensions/**/*.usdc
!/source/extensions/**/*.usdz
!/templates/**/*.usd
!/templates/**/*.usda
!/templates/**/*.usdc
!/templates/**/*.usdz
