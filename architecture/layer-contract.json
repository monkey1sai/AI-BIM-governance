{
  "$schema": "./layer-contract.schema.json",
  "schema_version": "ai-bim-layer-contract/v1",
  "purpose": "Executable language-level layer boundaries. It declares, per scanned service, which module belongs to which layer and which layer may depend on which other layer. The observed module graph produced by the Phase 2 static scan is judged against this contract by scripts/lib/layered_architecture.py.",
  "enforcement_note": "Module-level cycles remain owned by ARCH-GRAPH-001 (architecture/observed-baseline.json). This contract judges direction across layers only. Same-layer edges are always permitted here and are not evidence that the design is healthy.",
  "tooling_deviation": {
    "named_tools": [
      "dependency-cruiser",
      "import-linter"
    ],
    "adopted": false,
    "reason": "The canonical root-contract CI job installs only pytest and jsonschema on windows-latest, apps/kit-manager-web has no package-lock.json to pin an npm dev tool against, and neither tool guarantees the byte-identical Windows/Linux report output this repository asserts for architecture artifacts. Layer boundaries are enforced instead by a standard-library checker that reuses the Phase 2 module-graph extractors and the same ratchet discipline, matching the declared Phase 2 GitNexus deviation. Adopting the named tools later remains possible and would be additive; this disclosure must be superseded rather than deleted.",
    "scope_limits": [
      "Only statically resolvable intra-service module imports are judged. Dynamic imports, runtime-resolved module names, and cross-service calls are out of scope.",
      "Files excluded by architecture/observed-graph.config.json (tests, fixtures, harness, generated, dist) are not scanned and therefore not layered."
    ]
  },
  "layer_sets": [
    {
      "language": "typescript",
      "layers": [
        "ui",
        "application",
        "client",
        "domain"
      ],
      "description": "ui renders and handles user interaction; application holds orchestration, routing and state machines; client owns outbound transport adapters; domain holds pure types, helpers and shared primitives.",
      "allowed": [
        {
          "from": "ui",
          "to": [
            "application",
            "client",
            "domain"
          ]
        },
        {
          "from": "application",
          "to": [
            "client",
            "domain"
          ]
        },
        {
          "from": "client",
          "to": [
            "domain"
          ]
        },
        {
          "from": "domain",
          "to": []
        }
      ]
    },
    {
      "language": "python",
      "layers": [
        "api",
        "application",
        "domain",
        "infrastructure"
      ],
      "description": "api is the inbound HTTP or host entry-point surface; application holds use-case orchestration and package facades; domain holds pure models and rules; infrastructure holds outbound adapters, stores and process-level side effects.",
      "allowed": [
        {
          "from": "api",
          "to": [
            "application",
            "domain",
            "infrastructure"
          ]
        },
        {
          "from": "application",
          "to": [
            "domain",
            "infrastructure"
          ]
        },
        {
          "from": "infrastructure",
          "to": [
            "domain"
          ]
        },
        {
          "from": "domain",
          "to": []
        }
      ]
    }
  ],
  "excluded_services": [],
  "services": [
    {
