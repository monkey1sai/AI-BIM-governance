        "client",
        "domain"
      ],
      "rules": [
        {
          "match": "prefix",
          "value": "services/",
          "layer": "client"
        },
        {
          "match": "exact",
          "value": "types.ts",
          "layer": "domain"
        },
        {
          "match": "exact",
          "value": "config.ts",
          "layer": "domain"
        },
        {
          "match": "prefix",
          "value": "lib/",
          "layer": "domain"
        },
        {
          "match": "prefix",
          "value": "utils/",
          "layer": "domain"
        },
        {
          "match": "exact",
          "value": "index.ts",
          "layer": "application"
        },
        {
          "match": "exact",
          "value": "app.ts",
          "layer": "application"
        },
        {
          "match": "exact",
          "value": "shutdown.ts",
          "layer": "application"
