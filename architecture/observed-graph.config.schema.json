{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-bim-governance.local/schemas/observed-graph-config.schema.json",
  "title": "AI-BIM observed dependency graph extraction config",
  "description": "Declares how repository directories map onto architecture contract services for the deterministic observed-architecture scan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "extraction_method",
    "service_roots",
    "exclude_path_fragments",
    "exclude_file_suffixes",
    "exclude_file_prefixes",
    "source_suffixes",
    "compose_files",
    "compose_service_map"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "ai-bim-observed-graph-config/v1" },
    "purpose": { "type": "string", "minLength": 1 },
    "extraction_method": { "const": "stdlib-static-source-scan" },
    "advisory_only_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "service_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract_service", "language", "roots", "inbound_edge_ports"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "browser_client": {
            "type": "boolean",
            "description": "True for browser clients, which are never called by another service and therefore legitimately declare no inbound_edge_ports."
          },
          "contract_service": {
            "type": ["string", "null"],
            "description": "Contract service id, or null when the observed node is not yet declared in architecture-contract.json."
          },
          "language": { "enum": ["python", "typescript"] },
          "roots": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "inbound_edge_ports": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "inbound_edge_port_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "edge_suppression_line_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exclude_path_fragments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exclude_file_suffixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exclude_file_prefixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_suffixes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "typescript"],
      "properties": {
        "python": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "typescript": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "compose_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "compose_service_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["compose_service", "service"],
        "properties": {
          "compose_service": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
